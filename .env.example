# Copy to .env for local runs. On Render, set these as Environment Variables.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Curate (persona reactions) model — fast and cheap
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Create workspace model — stronger writer/researcher for administrators
ANTHROPIC_MODEL_CREATE=claude-sonnet-4-5

# Team ACCESS CODE: a new person enters this once to create their own account.
LOGIN_PASSWORD=cottage2026

# Administrators (comma-separated). They get the Create workspace + Team & access.
ADMIN_EMAILS=mike@accordantphilanthropy.com,mike@beallcreative.com,k1greene@sbch.org

# Secret used to sign sign-in cookies. Change it to any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives. On Render, point this at your persistent disk,
# e.g. /var/data/ovl.db (mount the disk at /var/data).
DB_PATH=./evaluations.db

# Optional: AI face generation for custom personas (Replicate)
REPLICATE_API_TOKEN=
